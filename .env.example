# Open Notebook MCP Server Configuration

# Required: URL of your Open Notebook instance
OPEN_NOTEBOOK_URL=http://localhost:5055

# Optional: Authentication password (if APP_PASSWORD is set in Open Notebook)
# OPEN_NOTEBOOK_PASSWORD=your_password_here

# Optional: Cloudflare Access service-token credentials. When both are set the
# server sends CF-Access-Client-Id / CF-Access-Client-Secret on every request,
# which lets you put your Open Notebook API behind a Cloudflare Access policy.
# CF_ACCESS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.access
# CF_ACCESS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Transport mode (default: stdio)
# MCP_TRANSPORT=stdio

# Optional: HTTP server configuration (only used if MCP_TRANSPORT=streamable-http)
# HOST=127.0.0.1
# PORT=8000
# MCP_PATH=/mcp
# STATELESS_HTTP=1
# JSON_RESPONSE=1
